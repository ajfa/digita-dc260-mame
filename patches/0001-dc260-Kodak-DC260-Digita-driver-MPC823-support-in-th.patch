+// license:BSD-3-Clause
+// copyright-holders:ajfa
+/*
+    Kodak DC260 digital camera (Digita operating environment)
+
+    Motorola MPC823 @ 49.152 MHz (PLL from a 32.768 kHz crystal)
+    8 MB DRAM, 2 MB flash (16-bit), CompactFlash through the PCMCIA controller
+    VxWorks 5.3 with FlashPoint's Digita on top
+
+    Memory map, as programmed by romInit:
+      00000000-007fffff  DRAM (CS1, CS2)
+      00810000-00817fff  camera ASIC (CS3)
+      02000000-          PCMCIA window
+      ff000000-ff003fff  MPC823 internal registers
+      ffe00000-ffefffff  flash: resources ("rsrc")
+      fff00000-ffffffff  flash: boot code and compressed VxWorks image
+
+    The flash contents come from the camera's own update files:
+    flshrsrc.bin is written at ffe00000 and schigh.bin (32-byte header) at
+    fff00100.
+*/
+
+#include "emu.h"
+
+#include "mpc823_imm.h"
+
+#include "bus/ata/ataintf.h"
+#include "bus/ata/hdd.h"
+#include "bus/rs232/rs232.h"
+#include "imagedev/harddriv.h"
+#include "cpu/powerpc/ppc.h"
+#include "machine/nvram.h"
+
+#include "screen.h"
+
+#include <deque>
+
+#define LOG_ASIC    (1U << 1)
+#define LOG_PCMCIA  (1U << 2)
+#define LOG_SPI     (1U << 3)
+#define LOG_MPU     (1U << 4)
+#define VERBOSE (LOG_ASIC | LOG_PCMCIA | LOG_MPU)
+#include "logmacro.h"
+
+namespace {
+
+class dc260_state : public driver_device
+{
+public:
+	dc260_state(const machine_config &mconfig, device_type type, const char *tag)
+		: driver_device(mconfig, type, tag)
+		, m_maincpu(*this, "maincpu")
+		, m_imm(*this, "imm")
+		, m_ata(*this, "cf")
+		, m_serial(*this, "serial")
+		, m_ram(*this, "ram")
+		, m_nvram(*this, "eeprom")
+		, m_screen(*this, "screen")
+		, m_sw(*this, "SW%u", 0U)
+		, m_dial(*this, "DIAL")
+		, m_power(*this, "POWER")
+	{ }
+
+	void dc260(machine_config &config) ATTR_COLD;
+
+	// the image pipeline (CCD, capture ASIC) and the audio codec are not emulated yet
+	static constexpr feature_type unemulated_features() { return feature::CAMERA | feature::SOUND; }
+
+protected:
+	virtual void machine_start() override ATTR_COLD;
+	virtual void machine_reset() override ATTR_COLD;
+
+private:
+	required_device<mpc823_device> m_maincpu;
+	required_device<mpc823_imm_device> m_imm;
+	required_device<ata_interface_device> m_ata;
+	required_device<rs232_port_device> m_serial;
+	required_shared_ptr<uint32_t> m_ram;
+	required_device<nvram_device> m_nvram;
+	required_device<screen_device> m_screen;
+	required_ioport_array<3> m_sw;
+	required_ioport m_dial;
+	required_ioport m_power;
+	bool m_powered_off = false;   // the MPU has cut the main supply, the Power button restarts
+	uint8_t m_power_last = 0;
+
+	void main_map(address_map &map) ATTR_COLD;
+	uint32_t screen_update(screen_device &screen, bitmap_rgb32 &bitmap, const rectangle &cliprect);
+
+	uint32_t asic_r(offs_t offset, uint32_t mem_mask);
+	void asic_w(offs_t offset, uint32_t data, uint32_t mem_mask);
+	uint8_t pcmcia_r(offs_t offset);
+	void pcmcia_w(offs_t offset, uint8_t data);
+	bool card_present();
+	harddisk_image_device *m_cf_image = nullptr;
+	uint8_t spi_xfer(offs_t data);
+
+	// 24C16 serial EEPROM (2 KB) on the CPM I2C bus: settings and calibration
+	uint8_t eeprom_i2c(offs_t op);
+	void eeprom_default(nvram_device &nvram, void *base, size_t size);
+	uint8_t m_eeprom[0x800];
+	uint16_t m_eeprom_ptr;
+	uint8_t m_eeprom_phase;
+
+	// camera sub-microcontroller ("MPU") on the SPI: it is the master and clocks every frame
+	void portc_w(offs_t offset, uint16_t data, uint16_t mem_mask);
+	TIMER_CALLBACK_MEMBER(mpu_step);
+	void mpu_camera_frame(const std::vector<uint8_t> &frame);
+	void mpu_queue_reply(uint8_t cmd, uint8_t sn, const std::vector<uint8_t> &payload);
+	std::vector<uint8_t> mpu_switches();
+	TIMER_CALLBACK_MEMBER(mpu_scan);
+	emu_timer *m_mpu_scan_timer;
+	uint8_t m_mpu_sw_sent[3];
+	bool m_mpu_sw_valid = false;   // switches are reported once the camera has read them
+
+	enum { MPU_CLOCK_CAMERA, MPU_RAISE_IRQ2, MPU_DELIVER };
+
+	uint32_t m_asic[0x8000 / 4];
+	uint16_t m_portc;
+	emu_timer *m_mpu_timer;
+	emu_timer *m_mpu_quiet_timer;   // the MPU answers once the camera stops sending
+	std::deque<std::vector<uint8_t>> m_mpu_outbox;
+	bool m_mpu_ack_due;
+	bool m_mpu_irq;
+};
+
+void dc260_state::machine_start()
+{
+	m_maincpu->ppcdrc_set_options(PPCDRC_COMPATIBLE_OPTIONS);
+	m_maincpu->ppcdrc_add_fastram(0x00000000, 0x007fffff, false, m_ram);
+
+	m_cf_image = m_ata->subdevice<harddisk_image_device>("0:cf:image");
+
+	m_mpu_timer = timer_alloc(FUNC(dc260_state::mpu_step), this);
+	m_mpu_scan_timer = timer_alloc(FUNC(dc260_state::mpu_scan), this);
+	m_mpu_quiet_timer = timer_alloc(FUNC(dc260_state::mpu_step), this);
+
+	m_nvram->set_base(m_eeprom, sizeof(m_eeprom));
+
+	save_item(NAME(m_asic));
+	save_item(NAME(m_eeprom));
+	save_item(NAME(m_eeprom_ptr));
+	save_item(NAME(m_eeprom_phase));
+	save_item(NAME(m_portc));
+	save_item(NAME(m_mpu_ack_due));
+	save_item(NAME(m_mpu_irq));
+	save_item(NAME(m_mpu_sw_sent));
+	save_item(NAME(m_mpu_sw_valid));
+	save_item(NAME(m_powered_off));
+	save_item(NAME(m_power_last));
+}
+
+void dc260_state::machine_reset()
+{
+	std::fill(std::begin(m_asic), std::end(m_asic), 0);
+	// PIPR slot B: CD1/CD2 low with a card, RDY high
+	m_imm->set_pcmcia_pins(card_present() ? 0x00000100 : 0x00001800);
+
+	m_portc = 0;
+	m_eeprom_ptr = 0;
+	m_eeprom_phase = 0;
+	m_mpu_outbox.clear();
+	m_mpu_ack_due = false;
+	m_mpu_irq = false;
+	m_mpu_sw_valid = false;
+	m_powered_off = false;
+	m_mpu_scan_timer->adjust(attotime::from_msec(20), 0, attotime::from_msec(20));
+}
+
+void dc260_state::portc_w(offs_t offset, uint16_t data, uint16_t mem_mask)
+{
+	uint16_t const rising = data & ~m_portc;
+	m_portc = data;
+
+	// PC12: the camera wants a frame clocked (a command, an acknowledge, or its receiver is armed)
+	if (rising & 0x0008)
+		m_mpu_timer->adjust(attotime::from_msec(1), MPU_CLOCK_CAMERA);
+
+	// PC8: the camera answers IRQ2 with its receiver armed
+	if ((rising & 0x0080) && m_mpu_irq)
+		m_mpu_timer->adjust(attotime::from_usec(100), MPU_DELIVER);
+}
+
+static std::string mpu_hex(const std::vector<uint8_t> &frame)
+{
+	std::string hex;
+	for (uint8_t b : frame)
+		hex += util::string_format(" %02x", b);
+	return hex;
+}
+
+/*
+    Link protocol, as the camera side (Kodak's mcon task) expects it:
+      camera command  : pulse PC12, the MPU clocks the frame out
+      MPU acknowledge : pulse PC12 again with the receiver armed, the MPU sends 00 00
+      MPU message     : IRQ2, the camera arms its receiver, the MPU clocks the frame in
+      camera ack      : pulse PC12, the MPU clocks out two bytes
+    Frames: type, index of last data byte, command, serial, data..., XOR of all before
+*/
+TIMER_CALLBACK_MEMBER(dc260_state::mpu_step)
+{
+	switch (param)
+	{
+		case MPU_CLOCK_CAMERA:
+		{
+			if (m_mpu_ack_due && m_imm->spi_slave_rx_ready())
+			{
+				LOGMASKED(LOG_MPU, "%9.4f MPU -> camera: 00 00 (ack)\n", machine().time().as_double());
+				m_imm->spi_slave_transfer({ 0x00, 0x00 });
+				m_mpu_ack_due = false;
+				if (!m_mpu_outbox.empty() && !m_mpu_irq)
+					m_mpu_quiet_timer->adjust(attotime::from_msec(30), MPU_RAISE_IRQ2);
+				break;
+			}
+			int const len = m_imm->spi_slave_tx_len();
+			// the camera answers IRQ2 with its receiver armed and a 257-byte dummy transmit
+			if (m_mpu_irq && len == 0x101 && m_imm->spi_slave_rx_ready())
+			{
+				m_mpu_timer->adjust(attotime::zero, MPU_DELIVER);
+				break;
+			}
+			if (len <= 0)
+			{
+				LOGMASKED(LOG_MPU, "%9.4f MPU: attention with nothing armed\n", machine().time().as_double());
+				break;
+			}
+			std::vector<uint8_t> const frame = m_imm->spi_slave_transfer(std::vector<uint8_t>(len, 0x00));
+			if (len == 2)
+			{
+				LOGMASKED(LOG_MPU, "%9.4f camera -> MPU:%s (ack)\n", machine().time().as_double(), mpu_hex(frame));
+				if (!m_mpu_outbox.empty() && !m_mpu_irq)
+					m_mpu_quiet_timer->adjust(attotime::from_msec(30), MPU_RAISE_IRQ2);
+			}
+			else
+				mpu_camera_frame(frame);
+			break;
+		}
+
+		case MPU_RAISE_IRQ2:
+			// never while the camera is in the middle of a command: its receiver is for our ack
+			if (m_mpu_ack_due)
+			{
+				m_mpu_quiet_timer->adjust(attotime::from_msec(5), MPU_RAISE_IRQ2);
+				break;
+			}
+			LOGMASKED(LOG_MPU, "%9.4f MPU: IRQ2\n", machine().time().as_double());
+			m_imm->irq_pin_w(2, 1);
+			m_mpu_irq = true;
+			m_mpu_timer->adjust(attotime::from_msec(10), MPU_DELIVER);
+			break;
+
+		case MPU_DELIVER:
+			if (!m_mpu_irq || m_mpu_outbox.empty())
+				break;
+			if (m_mpu_ack_due || !m_imm->spi_slave_rx_ready())
+			{
+				m_mpu_timer->adjust(attotime::from_msec(1), MPU_DELIVER);
+				break;
+			}
+			m_imm->irq_pin_w(2, 0);
+			m_mpu_irq = false;
+			LOGMASKED(LOG_MPU, "%9.4f MPU -> camera:%s\n", machine().time().as_double(), mpu_hex(m_mpu_outbox.front()));
+			m_imm->spi_slave_transfer(m_mpu_outbox.front());
+			m_mpu_outbox.pop_front();
+			break;
+	}
+}
+
+void dc260_state::mpu_camera_frame(const std::vector<uint8_t> &frame)
+{
+	LOGMASKED(LOG_MPU, "%9.4f camera -> MPU:%s\n", machine().time().as_double(), mpu_hex(frame));
+
+	if (frame.size() < 5 || frame[0] != 0x00)
+		return;
+
+	m_mpu_ack_due = true;
+	uint8_t const cmd = frame[2], sn = frame[3];
+
+	// only these commands have a reply decoder in the camera (decode_reply_data's table)
+	static const uint8_t replied[] = {
+			0x01, 0x02, 0x0a, 0x0b, 0x0c, 0x0d, 0x0e, 0x0f, 0x14, 0x15, 0x1e, 0x1f, 0x28, 0x29, 0x2a,
+			0x2b, 0x32, 0x3c, 0x3d, 0x3e, 0x3f, 0x40, 0x46, 0x64, 0x65, 0x6e, 0x78, 0x82, 0x8c };
+	if (std::find(std::begin(replied), std::end(replied), cmd) == std::end(replied))
+		return;
+
+	switch (cmd)
+	{
+		case 0x6e:
+		{
+			// switches and mode dial; the camera bit-reverses each byte, the dial is one-hot in
+			// the low nibble of the second byte (0x08 Capture, 0x04 Review, 0x02 Connect, 0x01 Brag Book info screen)
+			std::vector<uint8_t> const sw = mpu_switches();
+			std::copy(sw.begin(), sw.end(), m_mpu_sw_sent);
+			m_mpu_sw_valid = true;
+			mpu_queue_reply(cmd, sn, { sw[0], sw[1], sw[2], 0x00 });
+			break;
+		}
+
+		case 0x01:
+			// MPU information: two version bytes, then the model (lens commands need model 1)
+			mpu_queue_reply(cmd, sn, { 0x01, 0x00, 0x01, 0x00 });
+			break;
+
+		case 0x65:
+			// 65 ff: the camera has shut down and asks the MPU to cut the supply
+			if (frame[4] == 0xff)
+			{
+				LOGMASKED(LOG_MPU, "%9.4f MPU: power off\n", machine().time().as_double());
+				m_powered_off = true;
+				break;
+			}
+			[[fallthrough]];
+		case 0x64:
+			// power status: first byte flags, second the battery A/D reading (thresholds 139/121/99)
+			mpu_queue_reply(cmd, sn, { 0x00, 0xc0, 0x00, 0x00 });
+			break;
+
+		default:
+			mpu_queue_reply(cmd, sn, { 0x00, 0x00, 0x00, 0x00 });
+			break;
+	}
+}
+
+std::vector<uint8_t> dc260_state::mpu_switches()
+{
+	return { uint8_t(m_sw[0]->read()), uint8_t(m_sw[1]->read() | m_dial->read()), uint8_t(m_sw[2]->read()) };
+}
+
+// the MPU reports switch changes on its own with notification 0x0a
+TIMER_CALLBACK_MEMBER(dc260_state::mpu_scan)
+{
+	// with the supply cut, only the Power button matters: the MPU powers the camera up again
+	uint8_t const power = m_power->read();
+	bool const pressed = power && !m_power_last;
+	m_power_last = power;
+	if (m_powered_off)
+	{
+		if (pressed)
+		{
+			LOGMASKED(LOG_MPU, "%9.4f MPU: power on\n", machine().time().as_double());
+			machine().schedule_soft_reset();
+		}
+		return;
+	}
+
+	// switch changes are reported only once the camera has read them with command 6e
+	std::vector<uint8_t> const now = mpu_switches();
+	if (!m_mpu_sw_valid || std::equal(now.begin(), now.end(), m_mpu_sw_sent))
+		return;
+	std::copy(now.begin(), now.end(), m_mpu_sw_sent);
+
+	std::vector<uint8_t> msg = { 0x03, 0x05, 0x0a, now[0], now[1], now[2] };
+	uint8_t ck = 0;
+	for (uint8_t b : msg)
+		ck ^= b;
+	msg.push_back(ck);
+	LOGMASKED(LOG_MPU, "%9.4f MPU: switches%s\n", machine().time().as_double(), mpu_hex(now));
+	m_mpu_outbox.push_back(msg);
+	if (!m_mpu_irq && !m_mpu_ack_due)
+		m_mpu_quiet_timer->adjust(attotime::from_msec(2), MPU_RAISE_IRQ2);
+}
+
+void dc260_state::mpu_queue_reply(uint8_t cmd, uint8_t sn, const std::vector<uint8_t> &payload)
+{
+	std::vector<uint8_t> msg = { 0x01, 0x00, cmd, sn, 0x00 };
+	msg.insert(msg.end(), payload.begin(), payload.end());
+	msg[1] = msg.size() - 1;
+	uint8_t ck = 0;
+	for (uint8_t b : msg)
+		ck ^= b;
+	msg.push_back(ck);
+
+	m_mpu_outbox.push_back(msg);
+}
+
+uint32_t dc260_state::asic_r(offs_t offset, uint32_t mem_mask)
+{
+	if (!machine().side_effects_disabled())
+		LOGMASKED(LOG_ASIC, "%s: ASIC read %06x & %08x = %08x\n", machine().describe_context(), 0x810000 + offset * 4, mem_mask, m_asic[offset]);
+	return m_asic[offset];
+}
+
+void dc260_state::asic_w(offs_t offset, uint32_t data, uint32_t mem_mask)
+{
+	LOGMASKED(LOG_ASIC, "%s: ASIC write %06x = %08x & %08x\n", machine().describe_context(), 0x810000 + offset * 4, data, mem_mask);
+	COMBINE_DATA(&m_asic[offset]);
+}
+
+/*
+    CompactFlash in slot B.  The firmware programs window 0 as a 16-byte, 8-bit I/O window,
+    the "contiguous I/O" layout of a CF card: 0-7 task file, 8/9 data, D error,
+    E alternate status / device control, F drive address.
+*/
+bool dc260_state::card_present()
+{
+	return m_cf_image && m_cf_image->exists();
+}
+
+uint8_t dc260_state::pcmcia_r(offs_t offset)
+{
+	if (!card_present())
+		return 0xff;
+
+	uint8_t data = 0xff;
+	switch (offset & 0x0f)
+	{
+		case 0x0: case 0x8: case 0x9:
+			data = m_ata->cs0_r(0);
+			break;
+		case 0xd:
+			data = m_ata->cs0_r(1);
+			break;
+		case 0xe:
+			data = m_ata->cs1_r(6);
+			break;
+		case 0xf:
+			data = m_ata->cs1_r(7);
+			break;
+		default:
+			data = m_ata->cs0_r(offset & 7);
+			break;
+	}
+	if (!machine().side_effects_disabled() && (offset & 0x0f) != 0 && (offset & 0x0f) != 8 && (offset & 0x0f) != 9)
+		LOGMASKED(LOG_PCMCIA, "%s: CF read %x = %02x\n", machine().describe_context(), offset, data);
+	return data;
+}
+
+void dc260_state::pcmcia_w(offs_t offset, uint8_t data)
+{
+	if (!card_present())
+		return;
+
+	if ((offset & 0x0f) != 0 && (offset & 0x0f) != 8 && (offset & 0x0f) != 9)
+		LOGMASKED(LOG_PCMCIA, "%s: CF write %x = %02x\n", machine().describe_context(), offset, data);
+	switch (offset & 0x0f)
+	{
+		case 0x0: case 0x8: case 0x9:
+			m_ata->cs0_w(0, data);
+			break;
+		case 0xe:
+			m_ata->cs1_w(6, data);
+			break;
+		case 0xd: case 0xf:
+			break;
+		default:
+			m_ata->cs0_w(offset & 7, data);
+			break;
+	}
+}
+
+/*
+    No factory EEPROM dump exists.  An all-zero PRAM passes the camera's check (a zero
+    'chks' disables it); the one field that must be valid is the region code 'rgnc'
+    (byte 0x56 bit 6, four bits, MSB first): 1 = U.S. English.
+*/
+void dc260_state::eeprom_default(nvram_device &nvram, void *base, size_t size)
+{
+	uint8_t *const p = static_cast<uint8_t *>(base);
+	std::fill_n(p, size, 0);
+	p[0x57] = 0x40;
+}
+
+uint8_t dc260_state::eeprom_i2c(offs_t op)
+{
+	enum { IDLE, WORD_ADDRESS, WRITE, READ };
+	uint8_t const data = op & 0xff;
+
+	switch (op & 0xf00)
+	{
+		case mpc823_imm_device::I2C_START:
+			if ((data & 0xf0) != 0xa0)
+				return 0;
+			m_eeprom_ptr = ((data & 0x0e) << 7) | (m_eeprom_ptr & 0xff);
+			m_eeprom_phase = (data & 1) ? READ : WORD_ADDRESS;
+			return 1;
+
+		case mpc823_imm_device::I2C_WRITE:
+			if (m_eeprom_phase == WORD_ADDRESS)
+			{
+				m_eeprom_ptr = (m_eeprom_ptr & 0x700) | data;
+				m_eeprom_phase = WRITE;
+			}
+			else if (m_eeprom_phase == WRITE)
+			{
+				m_eeprom[m_eeprom_ptr] = data;
+				m_eeprom_ptr = (m_eeprom_ptr & ~0x0f) | ((m_eeprom_ptr + 1) & 0x0f);   // 16-byte pages
+			}
+			return 1;
+
+		case mpc823_imm_device::I2C_READ:
+		{
+			uint8_t const v = m_eeprom[m_eeprom_ptr];
+			m_eeprom_ptr = (m_eeprom_ptr + 1) & 0x7ff;
+			return v;
+		}
+
+		default:
+			m_eeprom_phase = IDLE;
+			return 0;
+	}
+}
+
+uint8_t dc260_state::spi_xfer(offs_t data)
+{
+	LOGMASKED(LOG_SPI, "SPI out %02x\n", data);
+	return 0xff;
+}
+
+uint32_t dc260_state::screen_update(screen_device &screen, bitmap_rgb32 &bitmap, const rectangle &cliprect)
+{
+	// VCCR bit 0 enables the video controller; 0x814 holds field A's frame buffer
+	uint32_t const base = m_imm->peek32(0x814);
+	if (m_powered_off || !(m_imm->peek32(0x800) >> 16 & 1) || base + 576 * 2 * 216 > 0x800000)
+	{
+		bitmap.fill(rgb_t::black(), cliprect);
+		return 0;
+	}
+
+	for (int y = cliprect.min_y; y <= cliprect.max_y; y++)
+	{
+		uint32_t *dst = &bitmap.pix(y);
+		offs_t src = base + (y >> 1) * 576 * 2;
+		for (int x = 0; x < 576; x += 2, src += 4)
+		{
+			// each 32-bit word holds Cb Y0 Cr Y1
+			uint32_t const w = m_ram[src >> 2];
+			int const cb = int(w >> 24) - 128;
+			int const y0 = (w >> 16) & 0xff;
+			int const cr = int((w >> 8) & 0xff) - 128;
+			int const y1 = w & 0xff;
+			for (int k = 0; k < 2; k++)
+			{
+				int const yy = k ? y1 : y0;
+				int const r = std::clamp(yy + (1436 * cr >> 10), 0, 255);
+				int const g = std::clamp(yy - ((352 * cb + 731 * cr) >> 10), 0, 255);
+				int const b = std::clamp(yy + (1815 * cb >> 10), 0, 255);
+				if (x + k >= cliprect.min_x && x + k <= cliprect.max_x)
+					dst[x + k] = rgb_t(r, g, b);
+			}
+		}
+	}
+	return 0;
+}
+
+void dc260_state::main_map(address_map &map)
+{
+	map(0x00000000, 0x007fffff).ram().share("ram");
+	map(0x00810000, 0x00817fff).rw(FUNC(dc260_state::asic_r), FUNC(dc260_state::asic_w));
+	map(0x02000000, 0x0200000f).mirror(0x01fffff0).rw(FUNC(dc260_state::pcmcia_r), FUNC(dc260_state::pcmcia_w));
+	map(0xff000000, 0xff003fff).rw(m_imm, FUNC(mpc823_imm_device::read), FUNC(mpc823_imm_device::write));
+	map(0xffe00000, 0xffffffff).rom().region("flash", 0);
+}
+

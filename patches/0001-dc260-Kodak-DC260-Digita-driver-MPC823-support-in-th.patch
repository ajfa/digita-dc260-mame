+// license:BSD-3-Clause
+// copyright-holders:ajfa
+/*
+    MPC823 internal memory map (IMMR block, 16K)
+
+    Everything not modelled below behaves as plain storage, which is what the
+    port, memory controller and clock registers need.  First access to each
+    unmodelled register is logged.
+*/
+
+#include "emu.h"
+#include "mpc823_imm.h"
+
+#include "multibyte.h"
+
+#include <cstdlib>
+#include <ctime>
+
+#define LOG_UNKNOWN (1U << 1)
+#define LOG_SMC     (1U << 2)
+#define LOG_CPM     (1U << 3)
+#define LOG_SPI     (1U << 4)
+#define LOG_IRQ     (1U << 5)
+#define LOG_I2C     (1U << 6)
+#define VERBOSE (LOG_UNKNOWN | LOG_CPM | LOG_SPI | LOG_I2C)
+#include "logmacro.h"
+
+DEFINE_DEVICE_TYPE(MPC823_IMM, mpc823_imm_device, "mpc823_imm", "MPC823 internal memory map")
+
+mpc823_imm_device::mpc823_imm_device(const machine_config &mconfig, const char *tag, device_t *owner, uint32_t clock)
+	: device_t(mconfig, MPC823_IMM, tag, owner, clock)
+	, device_serial_interface(mconfig, *this)
+	, device_nvram_interface(mconfig, *this)
+	, m_irq_cb(*this)
+	, m_txd_cb(*this)
+	, m_spi_cb(*this, 0xff)
+	, m_i2c_cb(*this, 0xff)
+	, m_portc_out_cb(*this)
+	, m_mem(*this, finder_base::DUMMY_TAG, -1)
+	, m_echo(nullptr)
+	, m_rtc_base(0)
+	, m_rtcsc(0)
+{
+}
+
+void mpc823_imm_device::device_start()
+{
+	m_pit_timer = timer_alloc(FUNC(mpc823_imm_device::pit_tick), this);
+	m_smc_timer = timer_alloc(FUNC(mpc823_imm_device::smc_poll), this);
+	m_rtc_timer = timer_alloc(FUNC(mpc823_imm_device::rtc_second), this);
+	m_i2c_timer = timer_alloc(FUNC(mpc823_imm_device::i2c_done), this);
+	for (auto &t : m_cpm_timer)
+		t = timer_alloc(FUNC(mpc823_imm_device::cpm_timer_tick), this);
+
+	if (const char *path = std::getenv("DIGITA_ECHO"))
+		m_echo = std::fopen(path, "ab");
+
+	save_item(NAME(m_ram));
+	save_item(NAME(m_irq_pins));
+	save_item(NAME(m_cpm_edge));
+	save_item(NAME(m_smc_rbptr));
+	save_item(NAME(m_smc_tbptr));
+	save_item(NAME(m_spi_rbptr));
+	save_item(NAME(m_spi_tbptr));
+	save_item(NAME(m_i2c_rbptr));
+	save_item(NAME(m_i2c_tbptr));
+	save_item(NAME(m_smc_tx_busy));
+	save_item(NAME(m_irq_state));
+	save_item(NAME(m_rtc_base));
+	save_item(NAME(m_rtcsc));
+}
+
+void mpc823_imm_device::device_reset()
+{
+	std::fill(std::begin(m_ram), std::end(m_ram), 0);
+	w16(RTCSC, m_rtcsc);
+	std::fill(std::begin(m_logged), std::end(m_logged), 0);
+	m_irq_pins = 0;
+	m_cpm_edge = 0;
+	m_smc_rbptr = m_smc_tbptr = 0;
+	m_spi_rbptr = m_spi_tbptr = 0;
+	m_i2c_rbptr = m_i2c_tbptr = 0;
+	m_smc_tx_busy = false;
+	m_irq_state = false;
+	m_irq_cb(0);
+	m_txd_cb(1);
+	m_pit_timer->adjust(attotime::never);
+	for (auto &t : m_cpm_timer)
+		t->adjust(attotime::never);
+	m_smc_timer->adjust(attotime::from_usec(100), 0, attotime::from_usec(100));
+	m_rtc_timer->adjust(attotime::from_seconds(1), 0, attotime::from_seconds(1));
+
+	set_data_frame(1, 8, PARITY_NONE, STOP_BITS_1);
+	set_rate(9600);
+	receive_register_reset();
+	transmit_register_reset();
+}
+
+// the RTC and RTCSC live on the keep-alive supply: they survive resets, and the nvram file
+// stores them with the host time of the save, so the clock keeps counting while MAME is closed.
+// A new camera starts with the host's local time and the RTC enabled, so it is taken as set.
+void mpc823_imm_device::nvram_default()
+{
+	std::time_t const now = std::time(nullptr);
+	std::tm utc = *std::gmtime(&now);
+	utc.tm_isdst = -1;
+	int64_t const local = int64_t(now) + (int64_t(now) - int64_t(std::mktime(&utc)));
+	m_rtc_base = uint32_t(local) - uint32_t(machine().time().seconds());
+	m_rtcsc = 0x0001;
+}
+
+bool mpc823_imm_device::nvram_read(util::read_stream &file)
+{
+	uint8_t buf[14];
+	auto const [err, actual] = util::read(file, buf, sizeof(buf));
+	if (err || actual != sizeof(buf))
+		return false;
+	uint32_t const rtc = get_u32be(buf);
+	int64_t const saved = int64_t(get_u64be(buf + 4));
+	int64_t const now = int64_t(std::time(nullptr));
+	m_rtc_base = rtc + uint32_t(now > saved ? now - saved : 0) - uint32_t(machine().time().seconds());
+	m_rtcsc = get_u16be(buf + 12);
+	return true;
+}
+
+bool mpc823_imm_device::nvram_write(util::write_stream &file)
+{
+	uint8_t buf[14];
+	put_u32be(buf, uint32_t(machine().time().seconds()) + m_rtc_base);
+	put_u64be(buf + 4, uint64_t(int64_t(std::time(nullptr))));
+	put_u16be(buf + 12, m_rtcsc);
+	auto const [err, actual] = util::write(file, buf, sizeof(buf));
+	return !err;
+}
+
+// periodic/interrupt timer clock: OSCCLK / 4 or / 512
+uint32_t mpc823_imm_device::pitrtclk() const
+{
+	return 32768 / ((r32(SCCR) & 0x01000000) ? 512 : 4);
+}
+
+/***************************************************************************
+    interrupts
+***************************************************************************/
+
+uint32_t mpc823_imm_device::cpm_pending() const
+{
+	uint32_t pending = m_cpm_edge;
+	static const int timer_vec[4] = { 0x19, 0x12, 0x0c, 0x07 };
+	for (int n = 0; n < 4; n++)
+		if ((r16(cpm_timer_reg(n, 0)) & 0x0010) && (r16(TER1 + 2 * n) & 0x0002))
+			pending |= 1U << timer_vec[n];
+	return pending;
+}
+
+uint32_t mpc823_imm_device::siu_pending()
+{
+	uint32_t pend = r32(SIPEND) & r32(SIEL) & 0xaaaaaaaa;   // edge-latched IRQ pins
+	pend |= m_irq_pins & ~r32(SIEL) & 0xaaaaaaaa;          // level-sensitive IRQ pins
+
+	// internal interrupt levels: level n sets SIPEND bit LVLn = 0x40000000 >> 2n
+	auto level = [] (uint16_t lvlmask) -> uint32_t
+	{
+		uint32_t bits = 0;
+		for (int n = 0; n < 8; n++)
+			if (lvlmask & (0x8000 >> n))
+				bits |= 0x40000000 >> (2 * n);
+		return bits;
+	};
+	uint16_t const piscr = r16(PISCR);
+	if ((piscr & 0x0084) == 0x0084)
+		pend |= level(piscr & 0xff00);
+
+	uint16_t const rtcsc = r16(RTCSC);
+	if (((rtcsc & 0x0088) == 0x0088) || ((rtcsc & 0x0044) == 0x0044))
+		pend |= level(rtcsc & 0xff00);
+
+	uint16_t const tbscr = r16(TBSCR);
+	if (((tbscr & 0x0088) == 0x0088) || ((tbscr & 0x0044) == 0x0044))
+		pend |= level(tbscr & 0xff00);
+
+	// CPM interrupt controller
+	uint32_t const cicr = r32(CICR);
+	if ((cicr & 0x00000080) && (cpm_pending() & r32(CIMR) & ~r32(CISR)))
+		pend |= 0x40000000 >> (2 * ((cicr >> 13) & 7));
+
+	return pend;
+}
+
+void mpc823_imm_device::update_irq()
+{
+	bool const state = (siu_pending() & r32(SIMASK)) != 0;
+	if (state != m_irq_state)
+	{
+		m_irq_state = state;
+		m_irq_cb(state ? ASSERT_LINE : CLEAR_LINE);
+	}
+}
+
+void mpc823_imm_device::irq_pin_w(int line, int state)
+{
+	uint32_t const bit = 0x80000000 >> (2 * line);
+	if (state && !(m_irq_pins & bit) && (r32(SIEL) & bit))
+		w32(SIPEND, r32(SIPEND) | bit);
+	if (state)
+		m_irq_pins |= bit;
+	else
+		m_irq_pins &= ~bit;
+	update_irq();
+}
+
+void mpc823_imm_device::portc_pin_w(int bit, int state)
+{
+	// port C interrupt pins PC15..PC4 map to CPM vectors
+	static const int vec[16] = { -1, -1, -1, -1, 0x01, 0x02, 0x06, 0x09, 0x0a, 0x0b, 0x0e, 0x0f, 0x17, 0x18, 0x1a, 0x1f };
+	uint16_t const mask = 1 << (15 - bit);
+	uint16_t const old = r16(PCDAT);
+	uint16_t const now = state ? (old | mask) : (old & ~mask);
+	w16(PCDAT, now);
+	if (vec[bit] >= 0 && old != now && (!state || !(r16(PCINT) & mask)))
+		m_cpm_edge |= 1U << vec[bit];
+	update_irq();
+}
+
+/***************************************************************************
+    timers
+***************************************************************************/
+
+void mpc823_imm_device::pit_reload()
+{
+	if (r16(PISCR) & 0x0001)
+	{
+		uint32_t const count = (r32(PITC) >> 16) + 1;
+		m_pit_timer->adjust(attotime::from_hz(pitrtclk()) * count);
+	}
+	else
+		m_pit_timer->adjust(attotime::never);
+}
+
+TIMER_CALLBACK_MEMBER(mpc823_imm_device::rtc_second)
+{
+	if (r16(RTCSC) & 0x0001)
+	{
+		w16(RTCSC, r16(RTCSC) | 0x0080);
+		update_irq();
+	}
+}
+
+TIMER_CALLBACK_MEMBER(mpc823_imm_device::pit_tick)
+{
+	w16(PISCR, r16(PISCR) | 0x0080);
+	pit_reload();
+	update_irq();
+}
+
+void mpc823_imm_device::smc_event(uint8_t ev)
+{
+	w8(SMCE1, r8(SMCE1) | ev);
+	if (ev & r8(SMCM1))
+		m_cpm_edge |= 1U << CPM_VEC_SMC1;
+	update_irq();
+}
+
+void mpc823_imm_device::spi_event(uint8_t ev)
+{
+	w8(SPIE, r8(SPIE) | ev);
+	if (ev & r8(SPIM))
+		m_cpm_edge |= 1U << CPM_VEC_SPI;
+	update_irq();
+}
+
+void mpc823_imm_device::i2c_event(uint8_t ev)
+{
+	w8(I2CER, r8(I2CER) | ev);
+	if (ev & r8(I2CMR))
+		m_cpm_edge |= 1U << CPM_VEC_I2C;
+	update_irq();
+}
+
+/***************************************************************************
+    I2C master: walks the transmit descriptors, a descriptor with the S bit
+    (or the first one) begins with an address byte; reads fill the next
+    receive descriptor
+***************************************************************************/
+
+TIMER_CALLBACK_MEMBER(mpc823_imm_device::i2c_done)
+{
+	i2c_transfer();
+}
+
+void mpc823_imm_device::i2c_transfer()
+{
+	bool started = false;
+	uint8_t ev = 0;
+
+	for (int guard = 0; guard < 16; guard++)
+	{
+		offs_t const tbd = 0x2000 + (m_i2c_tbptr & 0x1fff);
+		uint16_t const tstat = r16(tbd);
+		if (!(tstat & 0x8000))
+			break;
+
+		uint16_t const len = r16(tbd + 2);
+		uint32_t const buf = r32(tbd + 4);
+		bool nak = false;
+
+		if (len)
+		{
+			uint8_t const addr = m_mem->read_byte(buf);
+			if (!started || (tstat & 0x0400))
+			{
+				started = true;
+				nak = !m_i2c_cb(I2C_START | addr);
+				LOGMASKED(LOG_I2C, "I2C start %02x len %d BD %04x status %04x rx BD %04x status %04x%s\n", addr, len,
+						m_i2c_tbptr, tstat, m_i2c_rbptr, r16(0x2000 + (m_i2c_rbptr & 0x1fff)), nak ? " NAK" : "");
+				if (!nak && (addr & 1))
+				{
+					// read: the remaining length is the number of bytes to receive
+					offs_t const rbd = 0x2000 + (m_i2c_rbptr & 0x1fff);
+					uint16_t const rstat = r16(rbd);
+					uint16_t const n = len - 1;
+					if (rstat & 0x8000)
+					{
+						for (uint16_t i = 0; i < n; i++)
+							m_mem->write_byte(r32(rbd + 4) + i, m_i2c_cb(I2C_READ));
+						w16(rbd + 2, n);
+						w16(rbd, (rstat & ~0x8000) | 0x0800);
+						m_i2c_rbptr = (rstat & 0x2000) ? r16(I2C_PRAM + 0) : m_i2c_rbptr + 8;
+						w16(I2C_PRAM + 0x10, m_i2c_rbptr);
+						if (rstat & 0x1000)
+							ev |= 0x01;
+					}
+				}
+				else
+				{
+					for (uint16_t i = 1; i < len && !nak; i++)
+						nak = !m_i2c_cb(I2C_WRITE | m_mem->read_byte(buf + i));
+				}
+			}
+			else
+			{
+				for (uint16_t i = 0; i < len && !nak; i++)
+					nak = !m_i2c_cb(I2C_WRITE | m_mem->read_byte(buf + i));
+			}
+		}
+
+		w16(tbd, (tstat & ~0x8000) | (nak ? 0x0004 : 0));
+		m_i2c_tbptr = (tstat & 0x2000) ? r16(I2C_PRAM + 2) : m_i2c_tbptr + 8;
+		w16(I2C_PRAM + 0x20, m_i2c_tbptr);
+		if (nak)
+			ev |= 0x10;
+		else if (tstat & 0x1000)
+			ev |= 0x02;
+		if (nak || (tstat & 0x0800))
+			break;
+	}
+	m_i2c_cb(I2C_STOP);
+	LOGMASKED(LOG_I2C, "I2C transfer done, events %02x (I2CMR %02x CIMR %08x)\n", ev, r8(I2CMR), r32(CIMR));
+	if (ev)
+		i2c_event(ev);
+}
+
+/***************************************************************************
+    CPM general-purpose timers
+***************************************************************************/
+
+// reg: 0 TMR, 1 TRR, 2 TCR, 3 TCN
+offs_t mpc823_imm_device::cpm_timer_reg(int n, int reg) const
+{
+	return TMR1 + ((n & 2) ? 0x10 : 0) + reg * 4 + (n & 1) * 2;
+}
+
+void mpc823_imm_device::cpm_timer_reload(int n)
+{
+	uint16_t const tgcr = r16(TGCR) >> (4 * n);
+	uint16_t const tmr = r16(cpm_timer_reg(n, 0));
+	int const iclk = (tmr >> 1) & 3;
+	if (!(tgcr & 0x1) || (tgcr & 0x2) || iclk == 0 || iclk == 3)
+	{
+		m_cpm_timer[n]->adjust(attotime::never);
+		return;
+	}
+	uint32_t const prescale = ((tmr >> 8) & 0xff) + 1;
+	uint32_t const div = (iclk == 2) ? 16 : 1;
+	uint32_t const ref = r16(cpm_timer_reg(n, 1)) ? r16(cpm_timer_reg(n, 1)) : 0x10000;
+	attotime const period = attotime::from_hz(clock()) * (prescale * div * ref);
+	m_cpm_timer[n]->adjust(period, n, period);
+}
+
+TIMER_CALLBACK_MEMBER(mpc823_imm_device::cpm_timer_tick)
+{
+	w16(TER1 + 2 * param, r16(TER1 + 2 * param) | 0x0002);
+	update_irq();
+}
+
+/***************************************************************************
+    SMC1 in UART mode
+***************************************************************************/
+
+void mpc823_imm_device::smc_update_rate()
+{
+	uint32_t const brgc = r32(BRGC1);
+	if (!(brgc & 0x00010000))
+		return;
+	uint32_t const cd = ((brgc >> 1) & 0xfff) + 1;
+	uint32_t const div = (brgc & 1) ? 16 : 1;
+	uint32_t const baud = clock() / (cd * div * 16);
+	LOGMASKED(LOG_SMC, "SMC1 %d baud\n", baud);
+	set_rate(baud);
+}
+
+TIMER_CALLBACK_MEMBER(mpc823_imm_device::smc_poll)
+{
+	smc_try_transmit();
+}
+
+void mpc823_imm_device::smc_try_transmit()
+{
+	if (m_smc_tx_busy || !(r16(SMCMR1) & 0x0002))
+		return;
+
+	offs_t const bd = 0x2000 + (m_smc_tbptr & 0x1fff);
+	uint16_t const status = r16(bd);
+	if (!(status & 0x8000))
+		return;
+
+	uint16_t const len = r16(bd + 2);
+	uint32_t const buf = r32(bd + 4);
+	for (uint16_t i = 0; i < len; i++)
+	{
+		uint8_t const ch = m_mem->read_byte(buf + i);
+		if (m_echo)
+		{
+			std::fputc(ch, m_echo);
+			std::fflush(m_echo);
+		}
+	}
+
+	// the characters leave through the serial line at the programmed rate
+	if (len)
+	{
+		m_smc_tx_busy = true;
+		transmit_register_setup(m_mem->read_byte(buf));
+		w16(SMC1_PRAM + 0x3c, 1);   // index of next byte (internal)
+		w16(SMC1_PRAM + 0x3e, len);
+		return;
+	}
+
+	w16(bd, status & ~0x8000);
+	m_smc_tbptr = (status & 0x2000) ? r16(SMC1_PRAM + 2) : m_smc_tbptr + 8;
+	w16(SMC1_PRAM + 0x20, m_smc_tbptr);
+	if (status & 0x1000)
+		smc_event(0x02);
+	update_irq();
+}
+
+void mpc823_imm_device::tra_callback()
+{
+	m_txd_cb(transmit_register_get_data_bit());
+}
+
+void mpc823_imm_device::tra_complete()
+{
+	if (!m_smc_tx_busy)
+		return;
+
+	offs_t const bd = 0x2000 + (m_smc_tbptr & 0x1fff);
+	uint16_t const status = r16(bd);
+	uint16_t const index = r16(SMC1_PRAM + 0x3c);
+	uint16_t const len = r16(SMC1_PRAM + 0x3e);
+	if (index < len)
+	{
+		transmit_register_setup(m_mem->read_byte(r32(bd + 4) + index));
+		w16(SMC1_PRAM + 0x3c, index + 1);
+		return;
+	}
+
+	m_smc_tx_busy = false;
+	w16(bd, status & ~0x8000);
+	m_smc_tbptr = (status & 0x2000) ? r16(SMC1_PRAM + 2) : m_smc_tbptr + 8;
+	w16(SMC1_PRAM + 0x20, m_smc_tbptr);
+	if (status & 0x1000)
+		smc_event(0x02);
+	update_irq();
+	smc_try_transmit();
+}
+
+void mpc823_imm_device::rcv_complete()
+{
+	receive_register_extract();
+	uint8_t const ch = get_received_char();
+	if (!(r16(SMCMR1) & 0x0001))
+		return;
+
+	offs_t const bd = 0x2000 + (m_smc_rbptr & 0x1fff);
+	uint16_t const status = r16(bd);
+	if (!(status & 0x8000))
+	{
+		smc_event(0x10);   // busy: character lost
+		update_irq();
+		return;
+	}
+	m_mem->write_byte(r32(bd + 4), ch);
+	w16(bd + 2, 1);
+	w16(bd, status & ~0x8000);
+	m_smc_rbptr = (status & 0x2000) ? r16(SMC1_PRAM + 0) : m_smc_rbptr + 8;
+	w16(SMC1_PRAM + 0x10, m_smc_rbptr);
+	if (status & 0x1000)
+		smc_event(0x01);
+	update_irq();
+}
+
+/***************************************************************************
+    SPI master
+***************************************************************************/
+
+void mpc823_imm_device::spi_transfer()
+{
+	if (!(r16(SPMODE) & 0x0100))
+		return;
+
+	for (int guard = 0; guard < 64; guard++)
+	{
+		offs_t const tbd = 0x2000 + (m_spi_tbptr & 0x1fff);
+		uint16_t const tstat = r16(tbd);
+		if (!(tstat & 0x8000))
+			break;
+
+		offs_t const rbd = 0x2000 + (m_spi_rbptr & 0x1fff);
+		uint16_t const rstat = r16(rbd);
+		uint16_t const len = r16(tbd + 2);
+		uint32_t const tbuf = r32(tbd + 4);
+		uint32_t const rbuf = r32(rbd + 4);
+		bool const rx_ok = rstat & 0x8000;
+
+		for (uint16_t i = 0; i < len; i++)
+		{
+			uint8_t const out = m_mem->read_byte(tbuf + i);
+			uint8_t const in = m_spi_cb(out);
+			LOGMASKED(LOG_SPI, "SPI %02x -> %02x\n", out, in);
+			if (rx_ok)
+				m_mem->write_byte(rbuf + i, in);
+		}
+
+		w16(tbd, tstat & ~0x8000);
+		m_spi_tbptr = (tstat & 0x2000) ? r16(SPI_PRAM + 2) : m_spi_tbptr + 8;
+		w16(SPI_PRAM + 0x20, m_spi_tbptr);
+		uint8_t ev = 0x02;
+		if (rx_ok)
+		{
+			w16(rbd + 2, len);
+			w16(rbd, (rstat & ~0x8000) | 0x0800);
+			m_spi_rbptr = (rstat & 0x2000) ? r16(SPI_PRAM + 0) : m_spi_rbptr + 8;
+			w16(SPI_PRAM + 0x10, m_spi_rbptr);
+			ev |= 0x01;
+		}
+		spi_event(ev);
+		if (tstat & 0x0800)
+			break;
+	}
+	update_irq();
+}
+
+int mpc823_imm_device::spi_slave_tx_len() const
+{
+	offs_t const tbd = 0x2000 + (m_spi_tbptr & 0x1fff);
+	return (r16(SPMODE) & 0x0100) && (r16(tbd) & 0x8000) ? r16(tbd + 2) : -1;
+}
+
+bool mpc823_imm_device::spi_slave_rx_ready() const
+{
+	offs_t const rbd = 0x2000 + (m_spi_rbptr & 0x1fff);
+	return (r16(SPMODE) & 0x0100) && (r16(rbd) & 0x8000);
+}
+
+// the other end is the master: exchange a whole frame against the armed buffer descriptors
+std::vector<uint8_t> mpc823_imm_device::spi_slave_transfer(const std::vector<uint8_t> &mosi)
+{
+	std::vector<uint8_t> miso(mosi.size(), 0xff);
+	if (!(r16(SPMODE) & 0x0100))
+		return miso;
+
+	offs_t const tbd = 0x2000 + (m_spi_tbptr & 0x1fff);
+	offs_t const rbd = 0x2000 + (m_spi_rbptr & 0x1fff);
+	uint16_t const tstat = r16(tbd);
+	uint16_t const rstat = r16(rbd);
+	uint8_t ev = 0;
+
+	if (tstat & 0x8000)
+	{
+		uint16_t const len = r16(tbd + 2);
+		for (size_t i = 0; i < mosi.size() && i < len; i++)
+			miso[i] = m_mem->read_byte(r32(tbd + 4) + i);
+		w16(tbd, tstat & ~0x8000);
+		m_spi_tbptr = (tstat & 0x2000) ? r16(SPI_PRAM + 2) : m_spi_tbptr + 8;
+		w16(SPI_PRAM + 0x20, m_spi_tbptr);
+		if (tstat & 0x1000)
+			ev |= 0x02;
+	}
+	if (rstat & 0x8000)
+	{
+		uint16_t const mrblr = r16(SPI_PRAM + 6);
+		size_t const n = std::min<size_t>(mosi.size(), mrblr ? mrblr : 0x10000);
+		for (size_t i = 0; i < n; i++)
+			m_mem->write_byte(r32(rbd + 4) + i, mosi[i]);
+		w16(rbd + 2, n);
+		w16(rbd, (rstat & ~0x8000) | 0x0800);
+		m_spi_rbptr = (rstat & 0x2000) ? r16(SPI_PRAM + 0) : m_spi_rbptr + 8;
+		w16(SPI_PRAM + 0x10, m_spi_rbptr);
+		if (rstat & 0x1000)
+			ev |= 0x01;
+	}
+	LOGMASKED(LOG_SPI, "SPI slave frame of %d bytes, events %02x\n", int(mosi.size()), ev);
+	spi_event(ev);
+	update_irq();
+	return miso;
+}
+
+/***************************************************************************
+    communication processor commands
+***************************************************************************/
+
+void mpc823_imm_device::cpm_command(uint16_t cmd)
+{
+	int const op = (cmd >> 8) & 0xf;
+	int const ch = (cmd >> 4) & 0xf;
+	LOGMASKED(LOG_CPM, "CPM command %x channel %x\n", op, ch);
+
+	if (cmd & 0x8000)
+		return;
+
+	if (ch == 0x9)   // SMC1
+	{
+		if (op == 0 || op == 1)
+		{
+			m_smc_rbptr = r16(SMC1_PRAM + 0);
+			w16(SMC1_PRAM + 0x10, m_smc_rbptr);
+		}
+		if (op == 0 || op == 2)
+		{
+			m_smc_tbptr = r16(SMC1_PRAM + 2);
+			w16(SMC1_PRAM + 0x20, m_smc_tbptr);
+		}
+	}
+	else if (ch == 0x1)   // I2C
+	{
+		if (op == 0 || op == 1)
+		{
+			m_i2c_rbptr = r16(I2C_PRAM + 0);
+			w16(I2C_PRAM + 0x10, m_i2c_rbptr);
+		}
+		if (op == 0 || op == 2)
+		{
+			m_i2c_tbptr = r16(I2C_PRAM + 2);
+			w16(I2C_PRAM + 0x20, m_i2c_tbptr);
+		}
+	}
+	else if (ch == 0x5)   // SPI
+	{
+		if (op == 0 || op == 1)
+		{
+			m_spi_rbptr = r16(SPI_PRAM + 0);
+			w16(SPI_PRAM + 0x10, m_spi_rbptr);
+		}
+		if (op == 0 || op == 2)
+		{
+			m_spi_tbptr = r16(SPI_PRAM + 2);
+			w16(SPI_PRAM + 0x20, m_spi_tbptr);
+		}
+	}
+}
+
+/***************************************************************************
+    bus interface
+***************************************************************************/
+
+uint32_t mpc823_imm_device::read(offs_t offset, uint32_t mem_mask)
+{
+	offs_t const byteoff = offset << 2;
+
+	switch (byteoff)
+	{
+		case SIPEND:
+			return siu_pending();
+
+		case SIVEC:
+		{
+			uint32_t const pend = siu_pending() & r32(SIMASK);
+			int const n = pend ? __builtin_clz(pend) : 0x3c >> 2;
+			if (!machine().side_effects_disabled())
+				LOGMASKED(LOG_IRQ, "%s: SIVEC %d (pending %08x mask %08x)\n", machine().describe_context(), n, siu_pending(), r32(SIMASK));
+			return uint32_t(n) << 26 | uint32_t(n) << 10 | 0;
+		}
+
+		case RTC:
+			return uint32_t(machine().time().seconds()) + m_rtc_base;
+
+		case 0x0f0:   // PIPR
+			return m_pipr;
+
+		case PITR & ~3:
+			if (m_pit_timer->enabled())
+				return uint32_t(m_pit_timer->remaining().as_double() * pitrtclk()) << 16;
+			return 0;
+
+		case CIVR & ~3:
+		{
+			uint32_t const pend = cpm_pending() & r32(CIMR) & ~r32(CISR);
+			int const vec = pend ? 31 - __builtin_clz(pend) : 0;
+			// the acknowledged vector goes in service and stops requesting until CISR is written
+			if (pend && !machine().side_effects_disabled())
+			{
+				w32(CISR, r32(CISR) | (1U << vec));
+				update_irq();
+			}
+			if (!machine().side_effects_disabled())
+				LOGMASKED(LOG_IRQ, "%s: CIVR vector %02x (pending %08x CIMR %08x CISR %08x)\n", machine().describe_context(), vec, cpm_pending(), r32(CIMR), r32(CISR));
+			return (uint32_t(vec) << 27) | (r32(CIVR & ~3) & 0x0000ffff);
+		}
+	}
+
+	if (byteoff >= 0x2000 || !machine().side_effects_disabled())
+	{
+		if (byteoff < 0x2000 && !BIT(m_logged[offset >> 3], offset & 7) && byteoff >= 0x800 && byteoff != CPCR && byteoff != (SMCMR1 & ~3) && byteoff != (SMCE1 & ~3))
+		{
+			m_logged[offset >> 3] |= 1 << (offset & 7);
+			LOGMASKED(LOG_UNKNOWN, "%s: read %03x & %08x\n", machine().describe_context(), byteoff, mem_mask);
+		}
+	}
+	return r32(byteoff);
+}
+
+void mpc823_imm_device::write(offs_t offset, uint32_t data, uint32_t mem_mask)
+{
+	offs_t const byteoff = offset << 2;
+	uint32_t const old = r32(byteoff);
+	uint32_t val = (old & ~mem_mask) | (data & mem_mask);
+
+	switch (byteoff)
+	{
+		case SIPEND:
+			// writing ones clears edge-latched IRQ pins
+			w32(SIPEND, old & ~(data & mem_mask & 0xaaaaaaaa));
+			update_irq();
+			return;
+
+		case CIPR:
+			m_cpm_edge &= ~(data & mem_mask);
+			update_irq();
+			return;
+
+		case CISR:
+			// SPI and SMC1 requests latch on a new unmasked event and are released here:
+			// Kodak's SPI handler only acknowledges CISR and never clears SPIE
+			w32(CISR, old & ~(data & mem_mask));
+			m_cpm_edge &= ~(data & mem_mask & ((1U << CPM_VEC_SMC1) | (1U << CPM_VEC_SPI) | (1U << CPM_VEC_I2C)));
+			update_irq();
+			return;
+	}
+
+	w32(byteoff, val);
+	reg_written(byteoff, old, data, mem_mask);
+}
+
+void mpc823_imm_device::reg_written(offs_t byteoff, uint32_t old, uint32_t data, uint32_t mem_mask)
+{
+	switch (byteoff)
+	{
+		case SIMASK:
+		case SIEL:
+		case CICR:
+		case CIMR:
+			update_irq();
+			break;
+
+		case PISCR & ~3:
+			if (ACCESSING_BITS_16_31)
+			{
+				// PS is write-one-to-clear
+				uint16_t const oldv = old >> 16, newv = data >> 16;
+				w16(PISCR, (newv & ~0x0080) | (oldv & 0x0080 & ~newv));
+				if ((oldv ^ newv) & 0x0001)
+					pit_reload();
+				update_irq();
+			}
+			break;
+
+		case PITC:
+			pit_reload();
+			break;
+
+		case TBSCR & ~3:
+			if (ACCESSING_BITS_16_31)
+			{
+				uint16_t const oldv = old >> 16, newv = data >> 16;
+				w16(TBSCR, (newv & ~0x00c0) | (oldv & 0x00c0 & ~newv));
+				update_irq();
+			}
+			break;
+
+		case RTCSC & ~3:
+			if (ACCESSING_BITS_16_31)
+			{
+				uint16_t const oldv = old >> 16, newv = data >> 16;
+				w16(RTCSC, (newv & ~0x00c0) | (oldv & 0x00c0 & ~newv));
+				m_rtcsc = newv & ~0x00c0;
+				update_irq();
+			}
+			break;
+
+		case RTC:
+			m_rtc_base = r32(RTC) - uint32_t(machine().time().seconds());
+			break;
+
+		case CIVR & ~3:
+			break;
+
+		case CPCR & ~3:
+			if (ACCESSING_BITS_16_31)
+			{
+				uint16_t const cmd = r16(CPCR);
+				if (cmd & 0x0001)
+				{
+					cpm_command(cmd);
+					w16(CPCR, cmd & ~0x8001);
+				}
+			}
+			break;
+
+		case BRGC1:
+			smc_update_rate();
+			break;
+
+		case PCDAT & ~3:
+			if (ACCESSING_BITS_0_15 && ((old ^ data) & mem_mask & 0xffff))
+				m_portc_out_cb(0, r16(PCDAT), 0xffff);
+			break;
+
+		case TGCR:
+		case 0x990: case 0x994: case 0x9a0: case 0x9a4:
+			for (int n = 0; n < 4; n++)
+				cpm_timer_reload(n);
+			break;
+
+		case 0x9b0: case 0x9b4:
+			// TER: write one to clear
+			w32(byteoff, old & ~(data & mem_mask));
+			update_irq();
+			break;
+
+		case SMCMR1 & ~3:
+		case SMCE1 & ~3:
+		case SMCM1 & ~3:
+			if (byteoff == (SMCE1 & ~3) && ACCESSING_BITS_16_23)
+				w8(SMCE1, (old >> 16) & ~(data >> 16) & 0xff);
+			smc_try_transmit();
+			update_irq();
+			break;
+
+		case SPIE & ~3:
+			if (ACCESSING_BITS_8_15)
+				w8(SPIE, (old >> 8) & ~(data >> 8) & 0xff);
+			update_irq();
+			break;
+
+		case I2COM:
+			if (ACCESSING_BITS_24_31 && (r8(I2COM) & 0x80))
+			{
+				// the bus takes time: the firmware drains its completion semaphore right after starting
+				w8(I2COM, r8(I2COM) & 0x7f);
+				if ((r8(I2COM) & 0x01) && (r8(I2MOD) & 0x01))
+					m_i2c_timer->adjust(attotime::from_usec(300));
+			}
+			break;
+
+		case I2CER:
+			// write one to clear
+			if (ACCESSING_BITS_24_31)
+				w8(I2CER, (old >> 24) & ~(data >> 24) & 0xff);
+			update_irq();
+			break;
+
+		case I2CMR:
+			update_irq();
+			break;
+
+		case SPIM & ~3:
+			update_irq();
+			break;
+
+		case SPCOM & ~3:
+			if (ACCESSING_BITS_16_23 && (r8(SPCOM) & 0x80))
+			{
+				// as a slave the transfer waits for the master's clock
+				w8(SPCOM, 0);
+				if (r16(SPMODE) & 0x0200)
+					spi_transfer();
+			}
+			break;
+
+		default:
+			if (byteoff >= 0x800 && byteoff < 0x2000 && !BIT(m_logged[(byteoff >> 2) >> 3], (byteoff >> 2) & 7))
+			{
+				m_logged[(byteoff >> 2) >> 3] |= 1 << ((byteoff >> 2) & 7);
+				LOGMASKED(LOG_UNKNOWN, "%s: write %03x = %08x & %08x\n", machine().describe_context(), byteoff, data, mem_mask);
+			}
+			break;
+	}
+}
diff --git a/src/mame/kodak/mpc823_imm.h b/src/mame/kodak/mpc823_imm.h
new file mode 100644
index 00000000..7ac61484
--- /dev/null
+++ b/src/mame/kodak/mpc823_imm.h
@@ -0,0 +1,136 @@
+// license:BSD-3-Clause
+// copyright-holders:ajfa
+#ifndef MAME_KODAK_MPC823_IMM_H
+#define MAME_KODAK_MPC823_IMM_H
+
+#pragma once
+
+#include "diserial.h"
+
+// MPC823 internal memory map: SIU, system timers, CPM interrupt controller,
+// communication processor commands and SMC1 in UART mode
+class mpc823_imm_device : public device_t, public device_serial_interface, public device_nvram_interface
+{
+public:
+	mpc823_imm_device(const machine_config &mconfig, const char *tag, device_t *owner, uint32_t clock);
+
+	auto irq_cb() { return m_irq_cb.bind(); }
+	auto txd_cb() { return m_txd_cb.bind(); }
+	auto spi_cb() { return m_spi_cb.bind(); }
+	auto portc_out_cb() { return m_portc_out_cb.bind(); }
+
+	// I2C bus, byte level: offset 0x100|addr = start (returns ack), 0x200|data = write (returns ack),
+	// 0x300 = read a byte, 0x400 = stop
+	enum : offs_t { I2C_START = 0x100, I2C_WRITE = 0x200, I2C_READ = 0x300, I2C_STOP = 0x400 };
+	auto i2c_cb() { return m_i2c_cb.bind(); }
+	template <typename T> void set_space(T &&tag, int spacenum) { m_mem.set_tag(std::forward<T>(tag), spacenum); }
+
+	uint32_t read(offs_t offset, uint32_t mem_mask = ~0);
+	void write(offs_t offset, uint32_t data, uint32_t mem_mask = ~0);
+
+	void rxd_w(int state) { rx_w(state); }
+	void irq_pin_w(int line, int state);
+	void portc_pin_w(int bit, int state);
+	void set_pcmcia_pins(uint32_t pipr) { m_pipr = pipr; }   // PIPR: CD1/CD2 high = no card
+	uint32_t peek32(offs_t byteoff) const { return r32(byteoff); }
+	std::vector<uint8_t> spi_slave_transfer(const std::vector<uint8_t> &mosi);
+	int spi_slave_tx_len() const;
+	bool spi_slave_rx_ready() const;
+
+protected:
+	virtual void device_start() override ATTR_COLD;
+	virtual void device_reset() override ATTR_COLD;
+
+	virtual void nvram_default() override;
+	virtual bool nvram_read(util::read_stream &file) override;
+	virtual bool nvram_write(util::write_stream &file) override;
+
+	virtual void tra_callback() override;
+	virtual void tra_complete() override;
+	virtual void rcv_complete() override;
+
+private:
+	enum : uint32_t
+	{
+		SIPEND = 0x010, SIMASK = 0x014, SIEL = 0x018, SIVEC = 0x01c,
+		TBSCR = 0x200, RTCSC = 0x220, RTC = 0x224, PISCR = 0x240, PITC = 0x244, PITR = 0x248,
+		SCCR = 0x280, PLPRCR = 0x284,
+		CIVR = 0x930, CICR = 0x940, CIPR = 0x944, CIMR = 0x948, CISR = 0x94c,
+		PCDAT = 0x966, PCINT = 0x968,
+		TGCR = 0x980, TMR1 = 0x990, TER1 = 0x9b0,
+		CPCR = 0x9c0, BRGC1 = 0x9f0,
+		SMCMR1 = 0xa82, SMCE1 = 0xa86, SMCM1 = 0xa8a,
+		SPMODE = 0xaa0, SPIE = 0xaa6, SPIM = 0xaaa, SPCOM = 0xaad,
+		I2MOD = 0x860, I2COM = 0x86c, I2CER = 0x870, I2CMR = 0x874,
+		SMC1_PRAM = 0x3e80, SPI_PRAM = 0x3d80, I2C_PRAM = 0x3c80
+	};
+
+	enum : int
+	{
+		CPM_VEC_SMC1 = 0x04,
+		CPM_VEC_SPI = 0x05,
+		CPM_VEC_I2C = 0x10
+	};
+
+	devcb_write_line m_irq_cb;
+	devcb_write_line m_txd_cb;
+	devcb_read8 m_spi_cb;
+	devcb_write16 m_portc_out_cb;
+	devcb_read8 m_i2c_cb;
+	required_address_space m_mem;
+
+	uint8_t m_ram[0x4000];
+	emu_timer *m_pit_timer;
+	emu_timer *m_smc_timer;
+	emu_timer *m_cpm_timer[4];
+	emu_timer *m_rtc_timer;
+	emu_timer *m_i2c_timer;
+	uint32_t m_irq_pins;
+	uint32_t m_pipr = 0x00001800;
+	uint32_t m_cpm_edge;
+	uint16_t m_smc_rbptr;
+	uint16_t m_smc_tbptr;
+	uint16_t m_spi_rbptr;
+	uint16_t m_spi_tbptr;
+	uint16_t m_i2c_rbptr;
+	uint16_t m_i2c_tbptr;
+	bool m_smc_tx_busy;
+	bool m_irq_state;
+	FILE *m_echo;
+	uint32_t m_rtc_base;   // RTC minus emulated seconds; battery backed, survives resets
+	uint16_t m_rtcsc;      // RTCSC control bits, battery backed too
+	uint32_t m_logged[0x4000 / 32];
+
+	uint8_t r8(offs_t o) const { return m_ram[o & 0x3fff]; }
+	uint16_t r16(offs_t o) const { return (r8(o) << 8) | r8(o + 1); }
+	uint32_t r32(offs_t o) const { return (r16(o) << 16) | r16(o + 2); }
+	void w8(offs_t o, uint8_t v) { m_ram[o & 0x3fff] = v; }
+	void w16(offs_t o, uint16_t v) { w8(o, v >> 8); w8(o + 1, v); }
+	void w32(offs_t o, uint32_t v) { w16(o, v >> 16); w16(o + 2, v); }
+
+	void reg_written(offs_t byteoff, uint32_t old, uint32_t data, uint32_t mem_mask);
+	void smc_event(uint8_t ev);
+	void spi_event(uint8_t ev);
+	void i2c_event(uint8_t ev);
+	void i2c_transfer();
+	void cpm_command(uint16_t cmd);
+	void update_irq();
+	uint32_t cpm_pending() const;
+	uint32_t siu_pending();
+	void pit_reload();
+	TIMER_CALLBACK_MEMBER(pit_tick);
+	TIMER_CALLBACK_MEMBER(smc_poll);
+	TIMER_CALLBACK_MEMBER(cpm_timer_tick);
+	TIMER_CALLBACK_MEMBER(rtc_second);
+	TIMER_CALLBACK_MEMBER(i2c_done);
+	void cpm_timer_reload(int n);
+	offs_t cpm_timer_reg(int n, int reg) const;
+	void smc_update_rate();
+	void smc_try_transmit();
+	void spi_transfer();
+	uint32_t pitrtclk() const;
+};
+
+DECLARE_DEVICE_TYPE(MPC823_IMM, mpc823_imm_device)
+
+#endif // MAME_KODAK_MPC823_IMM_H

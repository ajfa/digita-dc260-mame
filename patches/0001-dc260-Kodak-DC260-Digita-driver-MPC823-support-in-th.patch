@@ -1357,6 +1380,9 @@ uint32_t ppc_device::ppccom_translate_address_internal(int intention, bool debug
 	if (!(m_cap & PPCCAP_OEA))
 		return 0x001;
 
+	if (m_cap & PPCCAP_8XX)
+		return ppc8xx_translate_address(intention, address);
+
 	/* also no translation necessary if translation is disabled */
 	if ((transtype == TR_FETCH && (m_core->msr & MSROEA_IR) == 0) || (transtype != TR_FETCH && (m_core->msr & MSROEA_DR) == 0))
 		return 0x001;
@@ -1533,6 +1559,71 @@ uint32_t ppc_device::ppccom_translate_address_internal(int intention, bool debug
 }
 
 
+/*-------------------------------------------------
+    MPC8xx MMU: the TLBs are only ever loaded by
+    software through Mx_EPN/Mx_TWC/Mx_RPN, so the
+    translation is a search of those entries
+-------------------------------------------------*/
+
+static uint32_t ppc8xx_page_mask(uint32_t twc, uint32_t rpn)
+{
+	switch ((twc >> 2) & 3)
+	{
+		case 1:  return 0xfff80000;                             // 512K
+		case 3:  return 0xff800000;                             // 8M
+		default: return (rpn & 0x8) ? 0xffffc000 : 0xfffff000;  // 16K or 4K
+	}
+}
+
+uint32_t ppc_device::ppc8xx_translate_address(int intention, offs_t &address)
+{
+	int const transtype = intention & TR_TYPE;
+	if ((transtype == TR_FETCH && !(m_core->msr & MSROEA_IR)) || (transtype != TR_FETCH && !(m_core->msr & MSROEA_DR)))
+		return 0x001;
+
+	int const side = (transtype == TR_FETCH) ? 0 : 1;
+	for (auto const &e : m_tlb8xx[side])
+	{
+		if (!(e.epn & 0x200) || !(e.rpn & 1))
+			continue;
+		uint32_t const mask = ppc8xx_page_mask(e.twc, e.rpn);
+		if ((address & mask) == (e.epn & mask))
+		{
+			address = (e.rpn & mask) | (address & ~mask);
+			return 0x001;
+		}
+	}
+	return DSISR_NOT_FOUND | ((transtype == TR_WRITE) ? DSISR_STORE : 0);
+}
+
+void ppc_device::ppc8xx_tlb_load(int side)
+{
+	uint32_t const ctr = m_core->spr[side ? SPR8XX_MD_CTR : SPR8XX_MI_CTR];
+	tlb8xx_entry &e = m_tlb8xx[side][(ctr >> 8) & 0x1f];
+	e.epn = m_core->spr[side ? SPR8XX_MD_EPN : SPR8XX_MI_EPN] | 0x200;
+	e.twc = m_core->spr[side ? SPR8XX_MD_TWC : SPR8XX_MI_TWC];
+	e.rpn = m_core->param1;
+	vtlb_flush_dynamic();
+	if (m_core->m_codepage_any)
+		m_core->m_translation_generation++;
+}
+
+void ppc_device::ppc8xx_tlb_invalidate(offs_t ea)
+{
+	for (auto &side : m_tlb8xx)
+		for (auto &e : side)
+			if ((e.epn & 0x200) && ((ea ^ e.epn) & ppc8xx_page_mask(e.twc, e.rpn)) == 0)
+				e.epn &= ~0x200;
+}
+
+void ppc_device::ppc8xx_tlb_invalidate_all()
+{
+	for (auto &side : m_tlb8xx)
+		for (auto &e : side)
+			e = tlb8xx_entry{ 0, 0, 0 };
+}
+

 // exception types
 enum
@@ -93,6 +94,11 @@ enum
 	EXCEPTION_ITLBMISS      = 16,       // PPCCAP_603_MMU
 	EXCEPTION_DTLBMISSL     = 17,       // PPCCAP_603_MMU
 	EXCEPTION_DTLBMISSS     = 18,       // PPCCAP_603_MMU
+	EXCEPTION_8XX_SWEMU     = 16,       // PPCCAP_8XX
+	EXCEPTION_8XX_ITLBMISS  = 17,       // PPCCAP_8XX
+	EXCEPTION_8XX_DTLBMISS  = 18,       // PPCCAP_8XX
+	EXCEPTION_8XX_ITLBERR   = 19,       // PPCCAP_8XX
+	EXCEPTION_8XX_DTLBERR   = 20,       // PPCCAP_8XX
 	EXCEPTION_COUNT
 };
 
@@ -211,7 +217,39 @@ enum
 	SPR603_HID0         = 0x3f0,    // R/W 603 Hardware Implementation Register 0
 	SPR603_HID1         = 0x3f1,    // R/W 603 Hardware Implementation Register 1
 	SPR603_IABR         = 0x3f2,    // R/W 603 Instruction Address Breakpoint Register
-	SPR603_HID2         = 0x3f3     // R/W 603
+	SPR603_HID2         = 0x3f3,    // R/W 603
+
+	// MPC8xx SPR register indexes
+	SPR8XX_EIE          = 0x050,    // W   8xx set MSR[EE] and MSR[RI]
+	SPR8XX_EID          = 0x051,    // W   8xx clear MSR[EE], set MSR[RI]
+	SPR8XX_NRI          = 0x052,    // W   8xx clear MSR[EE] and MSR[RI]
+	SPR8XX_IC_CST       = 0x230,    // R/W 8xx instruction cache control and status
+	SPR8XX_IC_ADR       = 0x231,
+	SPR8XX_IC_DAT       = 0x232,
+	SPR8XX_DC_CST       = 0x238,    // R/W 8xx data cache control and status
+	SPR8XX_DC_ADR       = 0x239,
+	SPR8XX_DC_DAT       = 0x23a,
+	SPR8XX_DPDR         = 0x276,
+	SPR8XX_IMMR         = 0x27e,    // R/W 8xx internal memory map register
+	SPR8XX_MI_CTR       = 0x310,    // R/W 8xx instruction MMU control
+	SPR8XX_MI_AP        = 0x312,
+	SPR8XX_MI_EPN       = 0x313,
+	SPR8XX_MI_TWC       = 0x315,
+	SPR8XX_MI_RPN       = 0x316,
+	SPR8XX_MD_CTR       = 0x318,    // R/W 8xx data MMU control
+	SPR8XX_M_CASID      = 0x319,
+	SPR8XX_MD_AP        = 0x31a,
+	SPR8XX_MD_EPN       = 0x31b,
+	SPR8XX_M_TWB        = 0x31c,
+	SPR8XX_MD_TWC       = 0x31d,
+	SPR8XX_MD_RPN       = 0x31e,
+	SPR8XX_M_TW         = 0x31f,
+	SPR8XX_MI_CAM       = 0x330,
+	SPR8XX_MI_RAM0      = 0x331,
+	SPR8XX_MI_RAM1      = 0x332,
+	SPR8XX_MD_CAM       = 0x338,
+	SPR8XX_MD_RAM0      = 0x339,
+	SPR8XX_MD_RAM1      = 0x33a
 };
 
 // PowerPC 4XX DCR register indexes
diff --git a/src/devices/cpu/powerpc/ppcdrc.cpp b/src/devices/cpu/powerpc/ppcdrc.cpp
index 39ba9b79..d77f4411 100644
--- a/src/devices/cpu/powerpc/ppcdrc.cpp
+++ b/src/devices/cpu/powerpc/ppcdrc.cpp
@@ -936,6 +936,11 @@ void ppc_device::static_generate_tlb_mismatch()
 	alloc_handle(m_drcuml.get(), &m_exception[EXCEPTION_ISI], "exception_isi");
 	if (m_cap & PPCCAP_603_MMU)
 		alloc_handle(m_drcuml.get(), &m_exception[EXCEPTION_ITLBMISS], "exception_itlb_miss");
+	if (m_cap & PPCCAP_8XX)
+	{
+		alloc_handle(m_drcuml.get(), &m_exception[EXCEPTION_8XX_ITLBMISS], "exception_itlb_miss");
+		alloc_handle(m_drcuml.get(), &m_exception[EXCEPTION_8XX_ITLBERR], "exception_itlb_error");
+	}
 
 	// begin generating
 	drcuml_block &block(m_drcuml->begin_invariant_block(20));
@@ -974,7 +979,17 @@ void ppc_device::static_generate_tlb_mismatch()
 	UML_CALLC(block, cfunc_ppccom_get_dsisr, this);                         // get reason to param1
 	UML_MOV(block, I1, mem(&m_core->param1));                               // mov     i1,[param1]
 	UML_AND(block, I1, I1, DSISR_NOT_FOUND | DSISR_PROTECTED | DSISR_NOEXEC);   // keep the SRR1 ISI reason bits
-	if (!(m_cap & PPCCAP_603_MMU))
+	if (m_cap & PPCCAP_8XX)
+	{
+		// the 8xx has no ISI: a fetch with no TLB entry is an ITLB miss, anything else an ITLB error
+		UML_TEST(block, I1, DSISR_PROTECTED | DSISR_NOEXEC);                    // test    i1,protected|noexec
+		UML_JMPc(block, COND_Z, itlbmiss = label++);                            // jmp     itlbmiss,z
+		UML_EXH(block, *m_exception[EXCEPTION_8XX_ITLBERR], I0);                // exh     itlberr,i0
+		UML_LABEL(block, itlbmiss);                                             // itlbmiss:
+		UML_AND(block, SPR32(SPR8XX_MI_EPN), I0, 0xfffff000);                   // and     [mi_epn],i0,0xfffff000
+		UML_EXH(block, *m_exception[EXCEPTION_8XX_ITLBMISS], I0);               // exh     itlbmiss,i0
+	}
+	else if (!(m_cap & PPCCAP_603_MMU))
 	{

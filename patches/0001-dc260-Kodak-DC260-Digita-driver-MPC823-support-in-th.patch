+void dc260_state::dc260(machine_config &config)
+{
+	MPC823(config, m_maincpu, 49'152'000);
+	m_maincpu->set_tb_divisor(6000);   // time base at OSCCLK / 4 = 8192 Hz
+	m_maincpu->set_addrmap(AS_PROGRAM, &dc260_state::main_map);
+
+	MPC823_IMM(config, m_imm, 49'152'000);
+	m_imm->set_space(m_maincpu, AS_PROGRAM);
+	m_imm->irq_cb().set_inputline(m_maincpu, PPC_IRQ);
+	m_imm->txd_cb().set(m_serial, FUNC(rs232_port_device::write_txd));
+	m_imm->spi_cb().set(FUNC(dc260_state::spi_xfer));
+	m_imm->portc_out_cb().set(FUNC(dc260_state::portc_w));
+	m_imm->i2c_cb().set(FUNC(dc260_state::eeprom_i2c));
+
+	NVRAM(config, m_nvram, nvram_device::DEFAULT_CUSTOM);
+	m_nvram->set_custom_handler(FUNC(dc260_state::eeprom_default));
+
+	// the LCD is fed by the MPC823 video controller: YCbCr 4:2:2, 576 x 216 per field, both fields alike
+	SCREEN(config, m_screen);
+	m_screen->set_lcd();
+	m_screen->set_refresh_hz(60);
+	m_screen->set_size(576, 432);
+	m_screen->set_visarea_full();
+	m_screen->set_screen_update(FUNC(dc260_state::screen_update));
+
+	ATA_INTERFACE(config, m_ata).options(ata_devices, "cf", nullptr, true);
+
+	RS232_PORT(config, m_serial, default_rs232_devices, nullptr);
+	m_serial->rxd_handler().set(m_imm, FUNC(mpc823_imm_device::rxd_w));
+}

     ppccom_translate_address - translate an address
     from logical to physical
@@ -1802,6 +1893,9 @@ void ppc_device::ppccom_dcbz_check()
 
 void ppc_device::ppccom_execute_tlbie()
 {
+	if (m_cap & PPCCAP_8XX)
+		ppc8xx_tlb_invalidate(m_core->param0);
+
 	// The 603/604/750 TLBs are indexed by the low bits of the effective page index alone
 	// (EA[15-19] on the 603, EA[14-19] on the 750), so tlbie invalidates that whole class.
 	// Mac OS X aliases user pages through its copyin/copyout window and expects the tlbie
@@ -1834,6 +1928,9 @@ void ppc_device::ppccom_execute_tlbie()
 
 void ppc_device::ppccom_execute_tlbia()
 {
+	if (m_cap & PPCCAP_8XX)
+		ppc8xx_tlb_invalidate_all();
+
 	vtlb_flush_dynamic();
 
 	// Any page's translation may be changing.  If any code is compiled, make
@@ -2035,6 +2132,34 @@ void ppc_device::ppccom_execute_mfspr()
 		}
 	}
 
+	/* handle 8XX SPRs */
+	if (m_cap & PPCCAP_8XX)
+	{
+		switch (m_core->param0)
+		{
+			case SPR603_TBL_R:
+				m_core->param1 = get_timebase();
+				return;
+			case SPR603_TBU_R:
+				m_core->param1 = get_timebase() >> 32;
+				return;
+
+			// the cache and TLB read-back ports are not modelled
+			case SPR8XX_IC_CST:
+			case SPR8XX_DC_CST:
+			case SPR8XX_IC_DAT:
+			case SPR8XX_DC_DAT:
+			case SPR8XX_MI_RAM0:
+			case SPR8XX_MI_RAM1:
+			case SPR8XX_MD_RAM0:
+			case SPR8XX_MD_RAM1:
+				m_core->param1 = 0;
+				return;
+		}
+		m_core->param1 = m_core->spr[m_core->param0];
+		return;
+	}
+
 	/* handle 4XX SPRs */
 	if (m_cap & PPCCAP_4XX)
 	{
@@ -2254,6 +2379,39 @@ void ppc_device::ppccom_execute_mtspr()
 		}
 	}
 
+	/* handle 8XX SPRs */
+	if (m_cap & PPCCAP_8XX)
+	{
+		switch (m_core->param0)
+		{
+			case SPR603_TBL_W:
+				set_timebase((get_timebase() & ~u64(0x00000000ffffffffU)) | m_core->param1);
+				return;
+			case SPR603_TBU_W:
+				set_timebase((get_timebase() & ~u64(0xffffffff00000000U)) | ((uint64_t)m_core->param1 << 32));
+				return;
+
+			case SPR8XX_MI_RPN:
+				ppc8xx_tlb_load(0);
+				return;
+			case SPR8XX_MD_RPN:
+				ppc8xx_tlb_load(1);
+				return;
+
+			case SPR8XX_IMMR:
+				m_core->spr[SPR8XX_IMMR] = (m_core->param1 & 0xffff0000) | (m_core->spr[SPR8XX_IMMR] & 0x0000ffff);
+				return;
+
+			case SPR8XX_IC_CST:
+				// invalidate-all and unlock-all commands
+				if (((m_core->param1 >> 25) & 7) == 6 && m_core->m_codepage_any)
+					invalidate_code_range(0, 0xffffffff);
+				return;
+		}
+		m_core->spr[m_core->param0] = m_core->param1;
+		return;
+	}
+
 	/* handle 4XX SPRs */
 	if (m_cap & PPCCAP_4XX)
 	{
diff --git a/src/devices/cpu/powerpc/ppccom.h b/src/devices/cpu/powerpc/ppccom.h
